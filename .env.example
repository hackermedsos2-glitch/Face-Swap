# Salin file ini jadi .env dan isi nilai aslinya. Jangan commit .env ke git.
DEBUG=True
SECRET_KEY=ganti-dengan-random-string-panjang
ALLOWED_HOSTS=127.0.0.1,localhost

DATABASE_URL=postgres://user:password@localhost:5432/faceswap_db

# Email backend untuk kirim OTP (contoh pakai Gmail SMTP untuk development)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=email-kamu@gmail.com
EMAIL_HOST_PASSWORD=app-password-gmail
DEFAULT_FROM_EMAIL=email-kamu@gmail.com

REDIS_URL=redis://localhost:6379/0
